# Required for Autopilot / agent (Claude Agent SDK)
ANTHROPIC_API_KEY=sk-ant-...

# Required for Bulk mode. Optional for Autopilot — when set, seller-website
# summaries use Groq instead of a plain page excerpt.
GROQ_API_KEY=gsk_...

# Optional — company enrichment for Bulk (industry, employees, tech stack)
CLEARBIT_API_KEY=sk_...
